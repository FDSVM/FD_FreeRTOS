version: 2
updates:

  # ------------------------
  # 1) GitHub Actions Updates
  # ------------------------
  - package-ecosystem: "github-actions"
    directory: "/.github/workflows"
    schedule:
      interval: weekly
    open-pull-requests-limit: 10
    target-branch: develop
    groups:
      actions-core:
        patterns:
          - "actions/*"
      setup-tools:
        patterns:
          - "setup-*"

  # ------------------------
  # 2) Docker Base Images Updates
  # ------------------------
  - package-ecosystem: "docker"
    directory: "/"
    schedule:
      interval: weekly
    open-pull-requests-limit: 5
    target-branch: develop
    groups:
      freertos-images:
        patterns:
          - "freertos/*"
      gcc-images:
        patterns:
          - "gcc:*"
      alpine-images:
        patterns:
          - "alpine:*"
      ubuntu-images:
        patterns:
          - "ubuntu:*"

  # ------------------------
  # 3) vcpkg / C++ Dependencies
  # ------------------------
  - package-ecosystem: "vcpkg"
    directory: "/vcpkg"
    schedule:
      interval: weekly
    open-pull-requests-limit: 5
    target-branch: develop
    groups:
      mbedtls:
        patterns:
          - "mbedtls*"
      freertos-libs:
        patterns:
          - "FreeRTOS*"
      lwip:
        patterns:
          - "lwip*"
      tinyusb:
        patterns:
          - "tinyusb*"
      catch2:
        patterns:
          - "catch2*"
